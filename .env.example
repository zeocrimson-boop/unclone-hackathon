# Optional voice service. Key needs deepfake:detect scope and sufficient credits.
DETECTIF_API_KEY=
DETECTIF_DEEPFAKE_URL=https://platform.detectif.ai/v1/deepfake/detect
# Optional community service. Use the managed provider's verified TLS settings.
DATABASE_URL=
# Generate a private random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store securely; never commit the generated value.
REPORT_ABUSE_SECRET=
PORT=3000
# Local: 0. Render direct Web Service proxy: 1; verify for your deployment.
TRUST_PROXY_HOPS=0
